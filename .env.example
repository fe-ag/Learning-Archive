# Copy this file to ".env" and replace the placeholder values.
# Never commit the real .env file.

# --- Core ---
DJANGO_DEBUG=True
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example: https://www.example.com,https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# --- Database (PostgreSQL) ---
# Use "sqlite" only for a quick local try-out; production must use "postgresql".
DB_ENGINE=postgresql
POSTGRES_DB=publication_site
POSTGRES_USER=publication_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Site ---
SITE_NAME=Learning Archive
SITE_TAGLINE=Articles, papers and learning resources, organised by category.
MAX_UPLOAD_MB=20

# --- Production hardening (set when serving over HTTPS) ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
# Set True when a reverse proxy terminates HTTPS and sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=False
